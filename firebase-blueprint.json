    "CashMovement": {
      "title": "CashMovement",
      "description": "Movimentações rastreáveis de dinheiro e caixa: sangrias, suprimentos, entradas de vendas e saídas de compras",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
