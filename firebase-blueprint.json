  "firestore": {
    "/empresas/{empresaId}": {
      "schema": { "$ref": "#/entities/Empresa" },
      "description": "Coleção raiz de Empresas multi-tenant (acesso por proprietário, equipe autorizada e Super Admin)"
    },
    "/empresas/{empresaId}/unidades/{unidadeId}": {
      "schema": { "$ref": "#/entities/Unidade" },
      "description": "Filiais / unidades vinculadas à empresa (gestão por Gerente/Admin da empresa)"
    },
    "/empresas/{empresaId}/unidades/{unidadeId}/configuracoes/{configId}": {
      "schema": { "$ref": "#/entities/UnitGatewayConfig" },
      "description": "Configurações de chaves de API e credenciais de pagamento vinculadas à unidade operacional"
    },
    "/empresas/{empresaId}/produtos/{produtoId}": {
      "schema": { "$ref": "#/entities/Produto" },
      "description": "Itens do cardápio da empresa (edição: Admin/Gerente; leitura: pública para cardápio digital e equipe)"
    },
    "/empresas/{empresaId}/categorias/{categoriaId}": {
      "schema": { "$ref": "#/entities/Categoria" },
      "description": "Categorias de produtos da empresa com isolamento multi-tenant (edição: Admin/Gerente; leitura: pública para cardápio digital e equipe)"
    },
    "/empresas/{empresaId}/pedidos/{pedidoId}": {
      "schema": { "$ref": "#/entities/Pedido" },
