        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "empresaId", "name", "status"]
    },
    "Produto": {
      "title": "Produto",
      "description": "Item do cardápio com vínculo multi-tenant à Empresa e Unidade específica ou global",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "empresaId": { "type": "string", "maxLength": 128 },
        "unidadeId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 60 },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "marginPercent": { "type": "number" },
        "cmvPercent": { "type": "number" },
        "available": { "type": "boolean" },
        "imageUrl": { "type": "string", "maxLength": 300 },
