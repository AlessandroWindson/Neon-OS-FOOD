        "kdsUpdatedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "empresaId", "total", "status", "paymentMethod", "paymentStatus"]
    },
    "WebhookLog": {
      "title": "WebhookLog",
