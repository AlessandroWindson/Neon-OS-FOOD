{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil e credenciais de acesso do usuário autenticado no Firebase Auth",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "companyName": { "type": "string", "maxLength": 120 },
        "role": { 
          "type": "string", 
          "enum": ["super_admin", "owner", "admin", "manager", "cashier", "waiter", "kitchen", "driver"],
          "maxLength": 30 
        },
        "empresaId": { "type": "string", "maxLength": 128 },
        "unidadeId": { "type": "string", "maxLength": 128 },
        "restaurantId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "email", "role"]
    },
    "Empresa": {
      "title": "Empresa",
      "description": "Registro mestre da empresa para isolamento multi-tenant (Multi-Tenancy Root)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "slug": { "type": "string", "maxLength": 80 },
        "cnpj": { "type": "string", "maxLength": 30 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerEmail": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "planId": { "type": "string", "maxLength": 50 },
        "planName": { "type": "string", "maxLength": 80 },
        "monthlyFee": { "type": "number" },
        "status": { 
          "type": "string", 
          "enum": ["active", "trial", "suspended", "deactivated", "canceled"],
          "maxLength": 30 
        },
        "branchesCount": { "type": "number" },
        "trialEndsAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "ownerId", "cnpj", "status"]
    },
    "Unidade": {
      "title": "Unidade",
      "description": "Filial ou unidade operacional vinculada a uma Empresa (Multi-Unidade)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "empresaId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "code": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 80 },
        "state": { "type": "string", "maxLength": 10 },
        "address": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "isMain": { "type": "boolean" },
        "status": { 
          "type": "string", 
          "enum": ["open", "closed", "Ativa", "Inativa", "Suspensa", "Em configuração"],
