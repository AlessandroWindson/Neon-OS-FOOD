        "deliveryFee": { "type": "number" },
        "serviceFee": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { 
          "type": "string", 
          "enum": ["pix", "credit_card", "debit_card", "cash", "voucher", "wallet"],
          "maxLength": 40 
        },
        "paymentStatus": { 
          "type": "string", 
          "enum": ["pending", "paid", "refunded"],
          "maxLength": 20 
        },
        "paidAmount": { "type": "number" },
        "pixTxId": { "type": "string", "maxLength": 100 },
        "pixEndToEndId": { "type": "string", "maxLength": 100 },
        "pixPaidAt": { "type": "string", "maxLength": 50 },
        "cardBrand": { "type": "string", "maxLength": 40 },
        "cardLast4": { "type": "string", "maxLength": 10 },
